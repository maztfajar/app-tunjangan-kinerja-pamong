# =============================================================================
# KONFIGURASI LINGKUNGAN (.ENV) - App Tunjangan Kinerja Pamong
# Salin file ini menjadi ".env" lalu sesuaikan nilainya:
#   cp .env.example .env
#
# TIPS CEPAT:
# Anda juga dapat menjalankan wizard konfigurasi otomatis di terminal:
#   node setup-db.js  (atau npm run db:setup)
# =============================================================================

# =============================================================================
# 1. DATABASE (PILIH SALAH SATU OPSI DI BAWAH)
# =============================================================================
# 
# -----------------------------------------------------------------------------
# OPSI 0: FILE STORAGE HOSTING (SQLite Bawaan) - LANGSUNG PUBLISH!
# -----------------------------------------------------------------------------
# Biarkan DATABASE_URL kosong: DATABASE_URL=""
# Aplikasi OTOMATIS membuat & menyimpan database di storage/database.sqlite
# Anda TIDAK PERLU setup database server sama sekali!
DATABASE_URL=""

# -----------------------------------------------------------------------------
# OPSI 1: DATABASE LOKAL DI WEB HOSTING (cPanel / VPS / Localhost)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/absensi_db?schema=public"

# Contoh jika menggunakan cPanel (biasanya nama db & user diawali prefix cpanel):
# DATABASE_URL="postgresql://cpaneluser_tukin:PasswordRahasia123@localhost:5432/cpaneluser_absensi?schema=public"

# -----------------------------------------------------------------------------
# OPSI 2: DATABASE CLOUD SUPABASE (Supabase.com)
# Gunakan jika Anda ingin database disimpan di cloud gratis Supabase.
# Ambil dari: Dashboard Supabase -> Project Settings -> Database -> Connection string -> URI
# CATATAN: Wajib menyertakan "?sslmode=require" di akhir URL.
# -----------------------------------------------------------------------------
# Contoh Mode Session Pooler (Port 5432 - Sangat Direkomendasikan untuk Prisma):
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Contoh Mode Direct Connection:
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# OPSI 3: DATABASE CLOUD LAINNYA (Neon.tech / Railway / Render)
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://user:password@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# TIPS PASSWORD DENGAN KARAKTER KHUSUS:
# Jika password database mengandung tanda '@', ubah menjadi '%40'
# Contoh: rahasia@123 -> rahasia%40123


# =============================================================================
# 2. KEAMANAN & AUTENTIKASI (WAJIB DIISI)
# =============================================================================
# String rahasia untuk token JWT (minimal 32 karakter unik).
# Buat string acak di Linux/Mac: openssl rand -base64 32
JWT_SECRET="ganti-dengan-string-rahasia-yang-kuat-dan-panjang-minimal-32-karakter"

# Kredensial login Super Administrator:
SUPERADMIN_USER="root"
SUPERADMIN_PASS="ganti-password-superadmin-anda"


# =============================================================================
# 3. PENGATURAN INSTANSI & KOORDINAT KANTOR DEFAULT (OPSIONAL)
# Koordinat & jam kerja bisa diubah kapan saja via UI Web Admin
# =============================================================================
NEXT_PUBLIC_APP_NAME="Absensi & Tunjangan Kinerja Pamong"
NEXT_PUBLIC_DEFAULT_LAT="-7.841817942758396"
NEXT_PUBLIC_DEFAULT_LNG="110.1685866543569"

JAM_MASUK="07:30"
JAM_PULANG="15:45"


# =============================================================================
# 4. CLOUDFLARE TURNSTILE / ANTI-BOT (OPSIONAL)
# Jika dikosongkan, sistem otomatis memakai testing key Cloudflare + smart fallback
# Ambil gratis di: dash.cloudflare.com -> Turnstile -> Add Site
# =============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
