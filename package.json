{
  "name": "absensi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "app:start": "bash start.sh",
    "app:prod": "bash start.sh --prod",
    "app:deploy": "bash deploy.sh",
    "start:cpanel": "NODE_ENV=production node server.js",
    "cpanel:pack": "bash pack-cpanel.sh",
    "db:push": "prisma db push",
    "db:init": "node prisma/init-db.js",
    "db:seed": "node prisma/seed.js",
    "db:check": "node check-db.js",
    "db:setup": "node setup-db.js",
    "postinstall": "prisma generate && prisma generate --schema=prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "prisma": "^6.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
